# Laufzeitdaten (Datenbank, Schlüssel) – niemals committen!
data/*
!data/.gitkeep
*.db
secret.key

# Update-Pakete & Sicherungen
*.zip
brickfolio-sicherung-*.json

# Python
__pycache__/
*.pyc
.venv/

# System
.DS_Store

.claude/settings.local.json
# Startbefehle für die Vorschau im Editor – Pfade eines einzelnen Rechners,
# nichts, was jemand anders gebrauchen könnte. Eine leere Fassung davon ist
# am 22.09.2026 versehentlich mit einem `git add -A` hereingerutscht.
.claude/launch.json
# Arbeitsbäume von Agentenläufen – ein vollständiger Abzug des Repos im Repo.
# Auf dem Mac mini lag so einer mit 3,5 MB unversioniert herum. Genau diese
# Sorte hat am 09.08.2026 schon einmal Ärger gemacht: Eine unversionierte
# Datei im Klon wurde später mit commitet, und der Wächter zog wochenlang
# nicht mehr nach.
.claude/worktrees/

# Katalogdaten gehen nicht auf GitHub.
#
# BrickLinks Nutzungsbedingungen (gemessen 21.08.2026): „not to distribute,
# disclose, upload, or transfer to any third party any content or data you
# receive from or which is displayed on the Site". Das Werkzeug darf ins
# Repo, die abgezogenen Daten nicht. Am 24.08.2026 lag ein 4,4-MB-Abzug
# schon unter hub/seed/, bevor es auffiel.
hub/seed/
*.katalog.sql
abzug*.sql


# Wrangler legt hier Kontokennung und Adresse ab. Das ist kein Schlüssel,
# gehört aber trotzdem nicht in ein öffentliches Repo – und die Datei wird
# bei jedem `wrangler`-Aufruf neu erzeugt.
.wrangler/

# Node-Abhängigkeiten. Standen nie im Repo, waren aber nur durch
# hub/.gitignore gedeckt – als der Hub am 22.09.2026 auszog, verschwand
# die Regel mit ihm, und `git add -A` sammelte 191 MB ein (ein einzelnes
# workerd-Binärstück mit 109 MB, das GitHub rundheraus ablehnte).
node_modules/
